{
    "name": "prestashopheaven/mono-build-knowledge",
    "description": "The knowledge of the PrestaHaven factory: the package index, the PrestaShop index per release and the external package search with its compatibility check, so a module reuses what exists before new code is written.",
    "version": "1.1.1",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "prestashopheaven/build-external": "1.1.1",
                    "prestashopheaven/build-package-index": "1.1.1",
                    "prestashopheaven/build-pitfalls": "1.1.1",
                    "prestashopheaven/build-prestashop-index": "1.1.1"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.1",
        "prestashopheaven/build-external": "*",
        "prestashopheaven/build-package-index": "*",
        "prestashopheaven/build-pitfalls": "*",
        "prestashopheaven/build-prestashop-index": "*"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "phpunit/phpunit": "^10.5",
        "prestashopheaven/build-tools": "^1.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "prestashopheaven": {
            "monorepo": {
                "kind": "build",
                "category": "knowledge"
            }
        }
    },
    "scripts": {
        "check": "ps-module mono check"
    }
}
